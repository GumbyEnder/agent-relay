{
  "schema": "beezilla/orchestration",
  "schemaVersion": 1,
  "id": "graph_x1",
  "name": "Research and ship a brief",
  "description": "Golden fixture for CR-3: every executable node type appears once.",
  "direction": "TD",
  "grid": 16,
  "entry": "n_start",
  "params": [
    { "name": "topic", "type": "string", "required": true, "default": null, "description": "" }
  ],
  "policy": { "maxConcurrency": 4, "budgetSec": 900, "onError": "stop" },
  "nodes": [
    { "id": "n_start", "type": "start", "name": "Start", "x": 0, "y": 0, "notes": "", "config": {} },
    { "id": "n_res", "type": "agent", "name": "Research", "x": 0, "y": 96, "notes": "",
      "config": {
        "prompt": "Research {{$input.topic}} and return the five most load-bearing facts.",
        "agent": "buzzy", "model": null, "tools": ["web_search", "web_extract"],
        "inputs": { "topic": "$input.topic" },
        "output": { "name": "findings", "schema": { "type": "array", "items": { "type": "string" } } },
        "timeoutSec": 300, "retries": 1,
        "onError": { "policy": "stop" }, "needsApproval": false
      } },
    { "id": "n_dec", "type": "decision", "name": "Enough findings?", "x": 0, "y": 224, "notes": "", "config": {} },
    { "id": "n_fan", "type": "parallel", "name": "Draft in parallel", "x": 0, "y": 352, "notes": "",
      "config": { "mode": "fan-out", "maxConcurrency": 2 } },
    { "id": "n_w1", "type": "agent", "name": "Write section A", "x": -192, "y": 480, "notes": "",
      "config": { "prompt": "Write section A from {{$n_res.findings}}.", "model": null, "tools": [],
        "inputs": { "findings": "$n_res.findings" }, "output": { "name": "text" },
        "timeoutSec": 180, "retries": 1, "onError": { "policy": "stop" }, "needsApproval": false } },
    { "id": "n_w2", "type": "agent", "name": "Write section B", "x": 192, "y": 480, "notes": "",
      "config": { "prompt": "Write section B from {{$n_res.findings}}.", "model": null, "tools": [],
        "inputs": { "findings": "$n_res.findings" }, "output": { "name": "text" },
        "timeoutSec": 180, "retries": 1, "onError": { "policy": "stop" }, "needsApproval": false } },
    { "id": "n_join", "type": "parallel", "name": "Join drafts", "x": 0, "y": 608, "notes": "",
      "config": { "mode": "join", "join": "all", "output": { "name": "draft" } } },
    { "id": "n_loop", "type": "loop", "name": "Tighten until clean", "x": 0, "y": 736, "notes": "",
      "config": { "until": "$n_edit.score >= 0.85", "maxIterations": 3 } },
    { "id": "n_edit", "type": "agent", "name": "Edit pass", "x": 0, "y": 864, "notes": "",
      "config": { "prompt": "Edit the joined draft and score it 0-1.", "model": null, "tools": [],
        "inputs": { "draft": "$n_join.draft" }, "output": { "name": "score", "schema": { "type": "number" } },
        "timeoutSec": 180, "retries": 0, "onError": { "policy": "stop" }, "needsApproval": false } },
    { "id": "n_appr", "type": "approval", "name": "Owner approves the brief", "x": 0, "y": 992, "notes": "",
      "config": { "prompt": "Approve the edited brief before it leaves the building.", "approver": "owner",
        "timeoutSec": 86400, "onTimeout": "stop" } },
    { "id": "n_end", "type": "end", "name": "End", "x": 0, "y": 1120, "notes": "",
      "config": { "outputs": { "score": "$n_edit.score" } } },
    { "id": "n_note", "type": "note", "name": "Why", "x": 320, "y": 0, "notes": "", "config": { "text": "Not executed." } }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "n_start", "port": "out" }, "to": { "node": "n_res", "port": "in" }, "label": "", "condition": null },
    { "id": "e2", "from": { "node": "n_res", "port": "out" }, "to": { "node": "n_dec", "port": "in" }, "label": "", "condition": null },
    { "id": "e3", "from": { "node": "n_dec", "port": "out" }, "to": { "node": "n_fan", "port": "in" }, "label": "yes", "condition": "$n_res.findings.length >= 3" },
    { "id": "e4", "from": { "node": "n_dec", "port": "out" }, "to": { "node": "n_end", "port": "in" }, "label": "no, stop", "condition": null },
    { "id": "e5", "from": { "node": "n_fan", "port": "out" }, "to": { "node": "n_w1", "port": "in" }, "label": "A", "condition": null },
    { "id": "e6", "from": { "node": "n_fan", "port": "out" }, "to": { "node": "n_w2", "port": "in" }, "label": "B", "condition": null },
    { "id": "e7", "from": { "node": "n_w1", "port": "out" }, "to": { "node": "n_join", "port": "in" }, "label": "", "condition": null },
    { "id": "e8", "from": { "node": "n_w2", "port": "out" }, "to": { "node": "n_join", "port": "in" }, "label": "", "condition": null },
    { "id": "e9", "from": { "node": "n_join", "port": "out" }, "to": { "node": "n_loop", "port": "in" }, "label": "", "condition": null },
    { "id": "e10", "from": { "node": "n_loop", "port": "body" }, "to": { "node": "n_edit", "port": "in" }, "label": "body", "condition": null },
    { "id": "e11", "from": { "node": "n_edit", "port": "out" }, "to": { "node": "n_loop", "port": "back" }, "label": "", "condition": null },
    { "id": "e12", "from": { "node": "n_loop", "port": "exit" }, "to": { "node": "n_appr", "port": "in" }, "label": "clean", "condition": null },
    { "id": "e13", "from": { "node": "n_appr", "port": "approved" }, "to": { "node": "n_end", "port": "in" }, "label": "approved", "condition": null },
    { "id": "e14", "from": { "node": "n_appr", "port": "rejected" }, "to": { "node": "n_edit", "port": "in" }, "label": "rejected", "condition": null }
  ],
  "meta": { "createdAt": "2026-11-22T23:20:00-05:00", "updatedAt": "2026-11-22T23:20:00-05:00", "generator": "human" }
}
