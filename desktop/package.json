{
  "name": "beezilla-desktop",
  "productName": "BeeZilla",
  "version": "0.1.0",
  "private": true,
  "description": "BeeZilla desktop — the local runtime in a window",
  "type": "module",
  "main": "main.mjs",
  "author": "BeeZilla",
  "scripts": {
    "start": "electron .",
    "stage": "node dist.mjs stage",
    "dist": "node dist.mjs all"
  },
  "build": {
    "appId": "ai.beezilla.desktop",
    "productName": "BeeZilla",
    "copyright": "BeeZilla",
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "supervisor.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/app",
        "to": "app"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
