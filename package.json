{
  "name": "agent-relay",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "description": "Dev Boards \u2014 harness-agnostic mission kanban for AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GumbyEnder/agent-relay.git"
  },
  "bugs": {
    "url": "https://github.com/GumbyEnder/agent-relay/issues"
  },
  "homepage": "https://github.com/GumbyEnder/agent-relay#readme",
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.3"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "preview": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run build && npm run test:ci",
    "test:ci": "npm run test:engine && npm run test:openapi-sync && npm run test:bz-f001-profile && npx tsx scripts/test-tool-registry.ts && npx tsx scripts/test-voice-tools.ts && npx tsx scripts/test-file-intent.ts",
    "test:engine": "npx tsx scripts/test-board-engine.ts && npm run test:history && npm run test:build-order && npm run test:refresh-scope && npm run test:p0p2 && npm run test:prod && npm run test:auth-email && npm run test:tenancy && npm run test:tenancy-endpoints && npm run test:skill-routing && npm run test:project-ref && npm run test:docs-html && npm run test:github-ingest",
    "test:tenancy": "npx tsx scripts/test-board-tenancy.ts",
    "test:skill-routing": "npx tsx scripts/test-skill-routing.ts",
    "test:project-ref": "npx tsx scripts/test-project-ref.ts",
    "test:docs-html": "npx tsx scripts/test-docs-html.ts",
    "test:tenancy-endpoints": "npx tsx scripts/test-tenancy-endpoints.ts",
    "test:github-ingest": "npx tsx scripts/test-github-ingest-extras.ts && npx tsx scripts/test-ingest-authz.ts",
    "test:api": "node scripts/agent-api-smoke.mjs",
    "test:buzzy-jobs": "node scripts/test-buzzy-jobs-ownership.mjs",
    "test:buzzy-resume": "node scripts/test-buzzy-resume.mjs",
    "smoke": "npm run test:engine && npm run test:api",
    "start": "node scripts/migrate.mjs && HOST=0.0.0.0 NITRO_HOST=0.0.0.0 node .output/server/index.mjs",
    "postbuild": "echo build complete",
    "test:history": "npx tsx scripts/test-history.ts",
    "test:build-order": "npx tsx scripts/test-build-order.ts",
    "test:refresh-scope": "npx tsx scripts/test-refresh-scope.ts",
    "test:p0p2": "npx tsx scripts/test-p0-p2.ts",
    "mcp": "node scripts/mcp-server.mjs",
    "test:prod": "npx tsx scripts/test-prod-ready.ts",
    "test:auth-email": "npx tsx scripts/test-auth-email.ts",
    "test:bz-f001-profile": "npx tsx scripts/test-bz-f001-profile.ts",
    "tui": "npm --prefix apps/tui run dev",
    "tui:status": "npm --prefix apps/tui run status",
    "tui:build": "npm --prefix apps/tui run build",
    "test:openapi-sync": "node scripts/test-openapi-sync.mjs",
    "test:tools": "npx tsx scripts/test-tool-registry.ts && npx tsx scripts/test-webpage-routing.ts && npx tsx scripts/test-voice-tools.ts && npx tsx scripts/test-file-intent.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@hookform/resolvers": "^5.0.0",
    "@openpanel/web": "^1.4.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.47",
    "better-auth": "^1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "docx": "+9.14.0",
    "exceljs": "+4.4.0",
    "kysely": "^0.29.7",
    "lucide-react": "^0.510.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pptxgenjs": "+4.0.1",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^2.13.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "lru-cache": "+11.5.3"
  }
}
