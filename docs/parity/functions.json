{
  "version": 1,
  "updated": "2026-11-03",
  "purpose": "Every user-facing function of Dev Boards / BeeZilla and where it actually exists. Two release lines serve this product \u2014 web (app.devboards.ai, github main) and desktop (BeeZilla installer, branch feat/local-runtime). This file is the contract between them: `node scripts/parity-check.mjs` fails when a page, an API family or a migration appears on one line and is not named here, or when a declaration stops being true. Divergence is allowed; unrecorded divergence is not.",
  "surfaces": {
    "web": {
      "tree": "~/agents/agent-relay-recipes",
      "remote": "github main",
      "deploy": "app.devboards.ai",
      "built": "git push github HEAD:main \u2192 railway redeploy --service agent-relay"
    },
    "desktop": {
      "tree": "~/agents/agent-relay-local",
      "remote": "github feat/local-runtime",
      "deploy": "BeeZilla installer (Electron shell + local runtime)",
      "built": "desktop/dist.mjs staging \u2192 Windows installer"
    }
  },
  "rules": [
    "A function is 'both' only when it is proven present on both surfaces \u2014 evidence paths, not intentions.",
    "A web-only function ships to the desktop by porting it to feat/local-runtime, then flipping this entry to 'both' in the same commit.",
    "A desktop-only function stays desktop-only only if it cannot work on the web (local runtime, BYOK key store, installer). Anything else is a product decision to write down.",
    "'drift' means present on both but behaviour is known to differ. It needs a note saying how, or it is a bug.",
    "Cloud contracts marked in `contract` are consumed by installed desktops. Changing one is a coordinated release, never a unilateral web deploy."
  ],
  "contract": [
    {
      "id": "cloud.inference-token",
      "endpoint": "POST /api/inference-token",
      "mints": "15-minute, inference-scoped, HMAC-signed token (bz1.<claims>.<sig>) for a desktop install",
      "consumedBy": "desktop/connect.mjs \u2192 scripts/lib/inference.mjs",
      "breaks": "a desktop install cannot chat at all; it refuses by name rather than 401",
      "verify": "curl -s -o /dev/null -w '%{http_code}' -X POST https://app.devboards.ai/api/inference-token \u2192 401 anonymous is correct; a signed-in mint returns bz1.*"
    },
    {
      "id": "cloud.search-token",
      "endpoint": "POST /api/search-token",
      "mints": "search-scoped token for the gateway route",
      "consumedBy": "desktop connect (search half) \u2192 scripts/lib/search-keys.mjs",
      "breaks": "desktop search silently falls back to BYOK-only",
      "verify": "desktop connect log line 'BeeZilla search connected'"
    },
    {
      "id": "cloud.search-gateway",
      "endpoint": "GET /api/search",
      "consumedBy": "desktop runtime search.ts pointed at the cloud gateway",
      "breaks": "desktop turns answer 'search is off' while the web still searches",
      "verify": "web-only today \u2014 no desktop route defines it"
    },
    {
      "id": "chat.sse",
      "endpoint": "POST /api/buzzy/chat (SSE: text \u00b7 audio \u00b7 done \u00b7 error)",
      "consumedBy": "both surfaces' talk.html",
      "breaks": "one surface streams, the other waits or drops the audio lane",
      "verify": "both trees contain voice.ts + the same event names"
    }
  ],
