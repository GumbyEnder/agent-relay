# Dev Boards (agent-relay) — copy to .env and adjust.
# Core path needs almost nothing for a local demo (PGLite + open agent API).

# ── Core (recommended for anything beyond a laptop) ─────────────────────────
# Postgres. If unset, the app uses embedded PGLite (fine for demos).
# DATABASE_URL=postgresql://relay:relay@127.0.0.1:5432/agent_relay

# Global agent API gate (optional). If unset, /api/agent is open — local only.
# Prefer per-agent ark_ keys from the UI for real use.
# AGENT_RELAY_API_KEY=

# Comma-separated emails that receive admin role after sign-up / first login.
# AGENT_RELAY_ADMIN_EMAILS=you@example.com

# ── Human operator sessions (optional) ──────────────────────────────────────
# Public origin of this app (enables real session cookies / email links).
# BETTER_AUTH_URL=http://127.0.0.1:8080
# BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:8080

# ── Email (optional; verification / notifications) ──────────────────────────
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=Dev Boards <noreply@example.com>
# RESEND_API_KEY=
# AGENT_RELAY_DEV_MAIL=1

# ── OAuth (optional — not required for core / agents) ───────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Integrations (optional) ─────────────────────────────────────────────────
# GITHUB_WEBHOOK_SECRET=

# ── Core (extra) ────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# ALLOWED_ORIGINS=http://127.0.0.1:8080
# 32+ random chars; signs session cookies and agent tokens.
# AUTH_SECRET=change-me-to-a-long-random-string
# Which agent this instance acts as, and where it reports to.
# AGENT_RELAY_AGENT=
# AGENT_RELAY_BASE_URL=http://127.0.0.1:8080
# AGENT_RELAY_BOARD=
# Encrypts `ark_` agent keys at rest. Changing it invalidates every issued key.
# AGENT_KEY_SEAL_SECRET=
# Require a human session (not just an agent key) on agent routes.
# AGENT_RELAY_HUMAN_AUTH=

# ── Runtime ─────────────────────────────────────────────────────────────────
# PORT=8080
# HOST=0.0.0.0
# VITE_AUTH_ENABLED=true

# ── Brand (optional) ────────────────────────────────────────────────────────
# Set to "beezilla" to activate the BeeZilla skin (default = neutral Dev Boards chrome).
# Both server and VITE_ prefix (baked at build time) are supported.
# BZ_BRAND=beezilla

# ── Buzzy / BeeZilla chat ───────────────────────────────────────────────────
# LLM provider (cloud-only — no local models). Any OpenAI-compatible gateway.
# Default: Nous Inference API. The first BZ_CHAT_MODELS entry is the latency-first
# default — the routing policy picks eligible[0].
# BZ_CHAT_BASE_URL=https://inference-api.nousresearch.com/v1
# BZ_CHAT_KEY=your-api-key-here
# BZ_CHAT_MODEL=z-ai/glm-5.3-flash
# BZ_CHAT_MODELS=[{"label":"Marvin","model":"google/gemini-3.1-flash-lite"},{"label":"Kimi","model":"moonshotai/kimi-k3"},{"label":"Qwen Thinking","model":"qwen/qwen3-235b-a22b-thinking"}]
# Slot/brief extraction and session summaries — cheap models are fine.
# BZ_EXTRACT_MODEL=
# BZ_SUMMARY_MODEL=
# How much of the model's real context window one turn may use.
# BZ_CONTEXT_TOKENS=
# Only for a self-hosted gateway that mints its own tokens.
# BZ_INFERENCE_BASE_URL=
# BZ_INFERENCE_MODEL=
# BZ_INFERENCE_SIGNING_KEY=
# Optional local filesystem root for operator drop-ins.
# BZ_LOCAL_ROOT=

# ── Voice (one voice: the audio model, never the browser) ───────────────────
# BZ_VOICE_MODEL=openai/gpt-audio-mini
# BZ_VOICE_NAME=alloy
# BZ_VOICE_FORMAT=pcm16
# Server-side transcription for browsers without SpeechRecognition (Firefox,
# Brave). Must accept `input_audio` on BZ_CHAT_BASE_URL.
# BZ_ASR_MODEL=openai/gpt-audio-mini

# ── Tools (web search + page reading) ──────────────────────────────────────
# Brave Search. Unset → web_search refuses instead of pretending.
# BZ_BRAVE_KEY=
# BZ_BRAVE_URL=https://api.search.brave.com/res/v1/web/search
# Renders pages a plain fetch cannot read. Unset → HTTP-only page reading.
# BZ_HYPERBROWSER_KEY=
# Optional internal search gateway (rate limiting / caching in front of Brave).
# BZ_SEARCH_GATEWAY_URL=

# ── Ops and scheduled work ─────────────────────────────────────────────────
# Read-only timing API: GET /api/buzzy/voice-metrics?days=N
# BZ_OPS_KEY=
# Authenticates scheduled job triggers.
# BZ_SCHEDULER_SECRET=

# ── Deploy (Railway) ───────────────────────────────────────────────────────
# BZ_RAILWAY_PROJECT=
# BZ_RAILWAY_SERVICE=
# Injected by Railway; set only when running deploy scripts locally.
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=
# RAILWAY_SERVICE_AGENT_RELAY_URL=

# ── Agent / dev tooling (not needed to run the app) ────────────────────────
# DEVBOARDS_BASE_URL=https://app.devboards.ai
# DEVBOARDS_API_KEY=
# DEVBOARDS_AGENT=
# DEVBOARDS_BOARD=
# Throwaway Postgres for the recipe/agent smoke scripts.
# DATABASE_URL_TEST=postgresql://postgres:***@127.0.0.1:55432/recipes
# BZ_TEST_KEY=
# BROWSER_SMOKE_TIMEOUT_MS=45000
# FIXTURE_LOG=

# ── Email (extra) ───────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=Dev Boards <noreply@example.com>
# Write mail to disk instead of sending it (local development).
# AGENT_RELAY_MAIL_LOG_DIR=

# ── OAuth (alternate variable names some deployments use) ───────────────────
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=

# ── Cloud memory (disabled pending scoped user consent) ───────────────────
# Honcho sync is disabled until an authenticated user-consent flow binds the
# destination and permitted content. These legacy settings alone do not
# authorize transmission and do not enable sync. Other network services are
# unchanged; previously transmitted Honcho data is not deleted by this change.
# BZ_HONCHO_URL=https://your-honcho.example
# BZ_HONCHO_KEY=your-honcho-jwt-here
# BZ_HONCHO_WORKSPACE=beezilla-clients

# ── Sealed recipes (marketplace) ───────────────────────────────────────────
# KEK that seals recipe bodies at rest. Rotating it orphans sealed recipes.
# RECIPE_SEAL_KEK=
# RECIPE_SEAL_STORAGE_DIR=
# 1 allows unsealed recipes in a local/dev instance. Never in production.
# RECIPE_SEAL_ALLOW_OPEN=0
# Local seeding helpers (see docs/RECIPE-SEAL.md).
# SEAL_SEED_TOKEN=
# SEAL_SEED_BASE=
# SEAL_SEED_VERSION=
# SEAL_SEED_AUTHOR_ID=
# SEAL_SEED_AUTHOR_NAME=
# SEAL_SEED_COOKIE=
# SEAL_PROBE_BASE=
# SEAL_PROBE_VERSION=

# ── Boards and scheduled claims ────────────────────────────────────────────
# SHARED_BOARDS=
# How long a claimed job may sit untouched before the scheduler reclaims it.
# STALE_CLAIM_RELEASE_HOURS=6
# Timeout for generating link preview thumbnails.
# PREVIEW_THUMBNAIL_TIMEOUT_MS=8000

# ── Misc ───────────────────────────────────────────────────────────────────
# NODE_ENV=development
# SMTP_PASSWORD=   (alias of SMTP_PASS; either works)
# RECIPIENTS=      (comma-separated addresses for operator notifications)
